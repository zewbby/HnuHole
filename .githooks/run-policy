#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python >/dev/null 2>&1 && python -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1; then
  exec python tools/check-collaboration.py "$@"
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1; then
  exec python3 tools/check-collaboration.py "$@"
else
  echo 'Python 3.9+ is required for collaboration hooks.' >&2
  exit 2
fi
